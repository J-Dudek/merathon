{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Merathon",
  "version": "2.10.0",
  "identifier": "com.gitclient.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Merathon — Git Repository Manager",
        "width": 1280,
        "height": 800,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "devCsp": {
        "default-src": "'self'",
        "script-src": "'self' 'unsafe-inline'",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data:",
        "font-src": "'self'",
        "connect-src": "ipc: http://ipc.localhost ws://localhost:1420 ws://localhost:1421 http://localhost:1420",
        "object-src": "'none'",
        "base-uri": "'none'",
        "form-action": "'none'",
        "frame-src": "'none'"
      },
      "freezePrototype": true
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "createUpdaterArtifacts": true,
    "publisher": "Julien Dudek",
    "copyright": "Copyright © 2026 Julien Dudek",
    "license": "MIT",
    "homepage": "https://github.com/J-Dudek/merathon",
    "category": "DeveloperTool",
    "shortDescription": "Client Git graphique de bureau",
    "longDescription": "Merathon est un client Git graphique : graphe des branches, indexation ligne par ligne, rebase interactif, résolution de conflits, sous-modules, Git LFS et comptes GitHub / GitLab.",
    "linux": {
      "deb": {
        "replaces": [
          "j6n"
        ],
        "conflicts": [
          "j6n"
        ]
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQ5QUY2MUIwOUU5QTlFMDQKUldRRW5wcWVzR0d2MlhqaXZSTjNGckNNRUcwalZrZUJkVnJSUlE2Mk9ncXkvaUgzVkprR1JYVW4K",
      "endpoints": [
        "https://github.com/J-Dudek/merathon/releases/latest/download/latest.json"
      ],
      "requireSignedVersion": true
    }
  }
}
